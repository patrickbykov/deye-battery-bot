# --- Колектор (застосунок deye-collector) ---

# Deye Cloud OpenAPI. Особистий акаунт логіниться email + sha256(пароль)
# РАЗОМ з appId/appSecret — креденшели застосунку ідентифікують лише застосунок.
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
DEYE_APP_ID=з developer.deyecloud.com
DEYE_APP_SECRET=звідти ж
DEYE_EMAIL=пошта акаунту Deye Cloud
DEYE_PASSWORD=пароль акаунту; хешує код, руками не треба

# InfluxDB Cloud. Токен лише на ЗАПИС у бакет, не All Access.
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_ORG=назва або id організації
INFLUX_TOKEN=токен deye-collector-write
INFLUX_BUCKET=monitoring

# Каданс хмари Deye — 10–15 хв, тож частіше немає сенсу
COLLECT_INTERVAL=300000
PORT=8080
