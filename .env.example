# --- Бот (застосунок deye-battery-bot) ---

# Telegram
TELEGRAM_BOT_TOKEN=токен від @BotFather
TELEGRAM_CHAT_ID=чат для сумісності зі старим кодом
ADMIN_CHAT_ID=chat id адміністратора; отримує заявки й адмінські команди

# Grafana Cloud
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SA_TOKEN=токен service account, роль Viewer
GRAFANA_DS_UID=uid датасорсу InfluxDB у Grafana
GRAFANA_DASHBOARD_UID=uid дашборду
# Панель теплокарти відключень. Не задавати, поки панель не створено:
# хибний id дасть не помилку, а чужу картинку. Дефолт у коді — 12.
GRAFANA_OUTAGE_PANEL_ID=12

# InfluxDB (бот ходить туди ВИНЯТКОВО через проксі Grafana — токена не треба)
INFLUXDB_BUCKET=monitoring

# Об'єкт за замовчуванням, поки підписки не заведені
DEFAULT_INVERTER_ID=серійник інвертора

# Веб-адмінка: хеш, не пароль.
#   echo -n "ваш-пароль" | node admin-auth.js
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>

# Спільний секрет з contact point типу webhook у Grafana
GRAFANA_WEBHOOK_TOKEN=32 випадкові байти base64url

# Порт HTTP (у проді задається в fly.toml)
PORT=8080

# --- Колектор має власний .env, див. collector/.env.example ---
